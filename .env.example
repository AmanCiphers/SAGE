# Required. Model access for the analyzer, tool loop, and vision.
NVIDIA_API_KEY=

# Optional. Model for the routing analyzer. It only emits one small JSON
# object per turn, so it defaults to a small model; the heavy model is spent
# on the turn that does the work. Set this to raise or lower routing quality.
#SAGE_ANALYZER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Optional. Search provider; without it search falls back to DuckDuckGo.
TAVILY_API_KEY=

# basic (default) or advanced. advanced returns page text inline.
SAGE_TAVILY_DEPTH=basic

# Enables bash and pc_control on the web surface. Leave off unless the server
# is on loopback or behind auth: these are arbitrary execution and full
# desktop control.
SAGE_ALLOW_LOCAL_TOOLS=0

# Where pc_control writes its audit trail.
# SAGE_AUDIT_LOG=

# Seconds between SSE keepalive comments.
# SAGE_KEEPALIVE=15

# Backend address baked into the front end at build time.
# SAGE_API=http://127.0.0.1:8000
